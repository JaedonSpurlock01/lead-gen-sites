---
import { Image } from "astro:assets";
import siteAssets from "virtual:site-assets";
import site from "virtual:site";
import type { Hero } from "@lead-gen/schema";
import { telHref } from "./format";

interface Props {
  hero: Hero;
}

const { hero } = Astro.props;
const { business } = site;
const image = hero.image ? siteAssets[hero.image] : undefined;
---

{hero.variant === "image" && image ? (
  <section class="hero">
    <div class="hero__image">
      <Image src={image} alt={hero.imageAlt ?? ""} width={768} height={Math.round((768 / image.width) * image.height)} loading="eager" fetchpriority="high" quality={45} />
    </div>
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1>{hero.h1}</h1>
      {hero.lede && <p class="hero__lede">{hero.lede}</p>}
      <div class="hero__actions">
        <a class="button" href="/contact/">Get a Free Estimate</a>
        <a class="button button--secondary" href={telHref(site)}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>
) : (
  <section class="page-hero">
    <div class="container">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1>{hero.h1}</h1>
      {hero.lede && <p>{hero.lede}</p>}
      {hero.actions?.length === 1 && <a class="button" href={hero.actions[0]!.href}>{hero.actions[0]!.text}</a>}
      {hero.actions && hero.actions.length > 1 && (
        <div class="hero__actions">
          {hero.actions.map((action) => (
            <a class:list={["button", action.style === "secondary" && "button--secondary"]} href={action.href}>{action.text}</a>
          ))}
        </div>
      )}
    </div>
  </section>
)}
