---
import niche from "virtual:niche";
import site from "virtual:site";
import { hoursDisplay, telHref } from "./format";

const { business } = site;
const icons: Record<string, { label: string; title: string; svg: string }> = {
  Facebook: { label: "Facebook", title: "Facebook", svg: '<path d="M14 8h3V4h-3c-3 0-5 2-5 5v2H6v4h3v7h4v-7h3l1-4h-4V9c0-.7.3-1 1-1Z"/>' },
  Instagram: { label: "Instagram", title: "Instagram", svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>' },
  Twitter: { label: "X, formerly Twitter", title: "X / Twitter", svg: '<path d="M4 3h5.2l4 5.7L18.2 3H20l-6 7 6.5 11H15l-4.3-6.1L5.5 21H3.6l6.2-7.3L4 3Zm4.1 2H7.7l8.4 14h.5L8.1 5Z"/>' },
  YouTube: { label: "YouTube", title: "YouTube", svg: '<path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.5.5a3 3 0 0 0-2.1 2.1C2 9.1 2 12 2 12s0 2.9.4 4.8a3 3 0 0 0 2.1 2.1c1.9.5 7.5.5 7.5.5s5.6 0 7.5-.5a3 3 0 0 0 2.1-2.1C22 14.9 22 12 22 12s0-2.9-.4-4.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z"/>' },
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2>Clear the clutter. Keep your project moving.</h2>
        <p>Talk with our team about your debris, timeline, and placement needs. Your dumpster rental estimate is free.</p>
        <a class="button" href={telHref(site)}>Call {business.phoneDisplay}</a>
      </div>
      <div>
        <h3>Dumpster Services</h3>
        <nav class="footer-links" aria-label="Footer services">
          {niche.services.map((service) => <a href={`/services/${service.slug}/`}>{service.formValue}</a>)}
          <a href="/dumpster-sizes/">Dumpster Size Guide</a>
        </nav>
      </div>
      <div>
        <h3>Contact</h3>
        <p>
          {business.serviceAreaLabel}<br />
          <a href={telHref(site)}>{business.phoneDisplay}</a><br />
          <a href={`mailto:${business.email}`}>{business.email}</a><br />
          {hoursDisplay(site.hours)}
        </p>
        <nav class="social-links" aria-label="Social media">
          {site.socials.map((social) => {
            const icon = icons[social.name]!;
            return (
              <a href={social.href} rel="nofollow noopener noreferrer" aria-label={icon.label} title={icon.title}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.svg} />
              </a>
            );
          })}
        </nav>
      </div>
    </div>
    <p class="copyright">© {new Date().getFullYear()} {business.name}. All rights reserved.</p>
  </div>
</footer>
