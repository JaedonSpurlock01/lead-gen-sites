---
import BaseLayout from "@lead-gen/engine/BaseLayout.astro";
import LeadForm from "@lead-gen/ui/LeadForm.astro";
import site from "virtual:site";
import InternalLinks from "../components/InternalLinks.astro";

const { business, hours } = site;

const title = `Contact ${business.city} Paving Contractor | Free Asphalt Estimate`;
const description =
  `Request a free estimate from a ${business.city} paving contractor — driveways, parking lots, pothole repair, crack sealing, and sealcoating. Call ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2">
      <div>
        <h1 class="text-4xl font-bold">Request a free asphalt estimate in {business.city}</h1>
        <p class="mt-5 text-lg">
          Quotes are 100% free. Tell us the approximate size and the service — driveway paving, parking lot paving, pothole repair, crack sealing, sealcoating, or private road paving. An estimator follows up during business hours.
        </p>
        <p class="mt-4">
          Call <a class="tracking-phone font-bold underline decoration-accent decoration-2 underline-offset-4" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
          or email <a class="font-semibold underline decoration-accent decoration-2 underline-offset-4" href={`mailto:${business.email}`}>{business.email}</a>.
        </p>
        <h2 class="mt-8 text-2xl font-bold">Service area</h2>
        <p class="mt-3">{business.serviceAreaLabel}</p>
        <p class="mt-2 text-sm text-ink-soft">Service is limited to {business.serviceAreaLabel}. No street address is published because estimates happen on your property. The same paving contractor team handles requests from Google Maps, phone, and this contact form.</p>
        <h2 class="mt-8 text-2xl font-bold">Hours</h2>
        <ul class="mt-3 space-y-2">
          {hours.map((row) => (
            <li class="flex max-w-xs justify-between gap-6">
              <span>{row.days}</span>
              <span>{row.time}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="border border-ink/10 bg-surface p-5 md:p-6">
        <h2 class="text-2xl font-bold">Project details</h2>
        <div class="mt-4">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>
  <InternalLinks />
</BaseLayout>
