---
import LeadForm from "@lead-gen/ui/LeadForm.astro";
import site from "virtual:site";

const { business, hours } = site;
---

<section class="bg-white py-16 md:py-24" id="estimate">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold">Request a free estimate</h2>
      <p class="prose-measure mt-4 text-ink-soft">
        Share the project size and how to reach you. An estimator from {business.name} follows up during posted hours: {hours.map((row) => `${row.days} ${row.time}`).join(" · ")}.
      </p>
      <a class="tracking-phone mt-6 inline-block bg-ink px-5 py-3 font-bold text-accent" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
    </div>
    <div class="border border-ink/10 bg-surface p-5 md:p-6">
      <LeadForm />
    </div>
  </div>
</section>
