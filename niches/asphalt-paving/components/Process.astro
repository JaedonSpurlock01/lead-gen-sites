---
import copy from "virtual:copy";

const steps = copy.steps ?? [];
---

<ol class="grid gap-8 md:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="border-t-4 border-accent bg-white p-5">
        <p class="text-sm font-bold tracking-wide text-ink-soft uppercase">Step {index + 1}</p>
        <h3 class="mt-2 text-xl font-bold">{step.title}</h3>
        <p class="mt-3 text-sm leading-6 text-ink-soft">{step.text}</p>
      </li>
    ))
  }
</ol>
