---
import BaseLayout from "@lead-gen/engine/BaseLayout.astro";
import site from "virtual:site";

const { business } = site;
---

<BaseLayout title={`Thank You | ${business.name}`} description="Your estimate request is in." noindex={true}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">Thank you. Your estimate request is in.</h1>
      <p class="mt-5 text-lg">We will reply during business hours. For anything urgent, call <a class="tracking-phone font-bold" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>.</p>
      <a class="mt-8 inline-block bg-ink px-5 py-3 font-bold text-accent" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>
