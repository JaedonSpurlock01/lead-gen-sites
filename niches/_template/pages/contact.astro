---
import BaseLayout from "@lead-gen/engine/BaseLayout.astro";
import LeadForm from "@lead-gen/ui/LeadForm.astro";
import niche from "virtual:niche";
import site from "virtual:site";

const { business, hours } = site;
---

<BaseLayout title={`Contact ${business.name} | Free Estimate`} description={`Request a free ${niche.name.toLowerCase()} estimate in ${business.serviceAreaLabel}. Call ${business.phoneDisplay}.`}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2">
      <div>
        <h1 class="text-4xl font-bold">Request a free estimate in {business.city}</h1>
        <p class="mt-4">Call <a class="tracking-phone font-bold underline decoration-accent decoration-2 underline-offset-4" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a> or email <a class="font-semibold underline decoration-accent decoration-2 underline-offset-4" href={`mailto:${business.email}`}>{business.email}</a>.</p>
        <h2 class="mt-8 text-2xl font-bold">Hours</h2>
        <ul class="mt-3 space-y-2">{hours.map((row) => <li class="flex max-w-xs justify-between gap-6"><span>{row.days}</span><span>{row.time}</span></li>)}</ul>
      </div>
      <div class="border border-ink/10 bg-surface p-5 md:p-6"><LeadForm /></div>
    </div>
  </section>
</BaseLayout>
