---
import BaseLayout from "@lead-gen/engine/BaseLayout.astro";
import site from "virtual:site";

const { business } = site;
---

<BaseLayout title={`Page not found | ${business.name}`} description={`That page is not on the ${business.name} site.`} noindex={true}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">That page is not here</h1>
      <a class="mt-6 inline-block font-semibold underline decoration-accent decoration-2 underline-offset-4" href="/">Go to the homepage</a>
    </div>
  </section>
</BaseLayout>
