---
import BaseLayout from "@lead-gen/engine/BaseLayout.astro";
import { serviceSchema } from "@lead-gen/engine/schema";
import { services } from "virtual:content";
import niche from "virtual:niche";
import site from "virtual:site";
import type { ServicePage } from "@lead-gen/schema";
import Diagram from "../../components/Diagram.astro";
import InternalLinks from "../../components/InternalLinks.astro";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { business } = site;
const { service } = Astro.props as { service: ServicePage };
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const imageSlot = niche.services.find((item) => item.slug === service.slug)?.imageSlot ?? "hero";
---

<BaseLayout title={`${service.title} | ${business.name}`} description={service.description} extraSchemas={[serviceSchema(service, pageUrl)]}>
  <article class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">{service.h1}</h1>
      <div class="mt-8"><Diagram name={imageSlot} label={service.description} loading="eager" /></div>
      {service.sections.map((section) => (
        <section class="mt-10">
          <h2 class="text-2xl font-bold">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p class="mt-4 text-ink-soft">{paragraph}</p>)}
          {section.bullets && <ul class="mt-4 list-disc space-y-2 pl-5">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </section>
      ))}
      <div class="mt-12 border border-ink/10 bg-surface p-6">
        <h2 class="text-2xl font-bold">Request a free estimate</h2>
        <p class="mt-3">Call <a class="tracking-phone font-bold" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a> or use the contact form.</p>
        <a class="mt-5 inline-block bg-accent px-5 py-3 font-bold text-ink" href="/contact">Request a free estimate</a>
      </div>
    </div>
  </article>
  <InternalLinks currentService={service.slug} />
</BaseLayout>
