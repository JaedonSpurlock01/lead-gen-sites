---
import copy from "virtual:copy";

const reasons = copy.reasons ?? [];

// Simple line icons; add more names here and reference them from copy/shared.yaml.
const icons: Record<string, string> = {
  shield: "M12 3l7 3v6c0 4.5-2.8 7.4-7 9-4.2-1.6-7-4.5-7-9V6l7-3z",
  pin: "M12 22s7-7.2 7-12a7 7 0 10-14 0c0 4.8 7 12 7 12zm0-9a3 3 0 110-6 3 3 0 010 6z",
  sun: "M12 7a5 5 0 100 10 5 5 0 000-10zM12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1",
  clock: "M12 4a8 8 0 100 16 8 8 0 000-16zm1 4v4.2l3 2-.8 1.3L11 13V8h2z",
};
---

<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    reasons.map((reason) => (
      <li class="border border-ink/10 bg-white p-6">
        <svg class="h-8 w-8 text-ink" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d={icons[reason.icon]} />
        </svg>
        <h3 class="mt-4 text-lg font-bold">{reason.title}</h3>
        <p class="mt-2 text-sm leading-6 text-ink-soft">{reason.text}</p>
      </li>
    ))
  }
</ul>
