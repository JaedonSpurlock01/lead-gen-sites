---
import { Image } from "astro:assets";
import siteAssets from "virtual:site-assets";
import LeadForm from "@lead-gen/ui/LeadForm.astro";
import niche from "virtual:niche";
import site from "virtual:site";

const { business } = site;
const hero = siteAssets.hero!;
---

<section class="relative isolate overflow-hidden text-surface">
  <Image src={hero} alt="" width={hero.width} height={hero.height} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" aria-hidden="true" />
  <div class="absolute inset-0 -z-10 bg-ink/50" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-16 md:grid-cols-[1.2fr_0.8fr] md:py-24">
    <div>
      <p class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">{business.name}</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight text-white md:text-5xl">{niche.name} in {business.city}</h1>
      <p class="prose-measure mt-5 text-lg text-surface-alt">{business.name} serves {business.serviceAreaLabel}. Free on-site estimates.</p>
      <a class="tracking-phone mt-6 inline-block bg-accent px-5 py-3 font-bold text-ink" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
    </div>
    <div class="bg-surface p-5 text-ink md:p-6" id="estimate">
      <h2 class="text-2xl font-bold">Request a free estimate</h2>
      <div class="mt-4"><LeadForm /></div>
    </div>
  </div>
</section>
