---
import { getImage } from "astro:assets";
import siteAssets from "virtual:site-assets";
import niche from "virtual:niche";
import site from "virtual:site";

const { business, hours } = site;
const faviconSource = siteAssets.favicon ?? siteAssets.logoDark!;
const [favicon32, favicon256, appleTouchIcon] = await Promise.all([
  getImage({ src: faviconSource, width: 32, height: 32, format: "png", fit: "contain" }),
  getImage({ src: faviconSource, width: 256, height: 256, format: "png", fit: "contain" }),
  getImage({ src: faviconSource, width: 180, height: 180, format: "png", fit: "contain" }),
]);

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  extraSchemas?: Record<string, unknown>[];
}

const { title, description, noindex = false, extraSchemas = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const dayGroups: Record<string, string | string[]> = {
  "Monday–Friday": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
  Saturday: "Saturday",
  Sunday: "Sunday",
};
const time24 = (value: string) => {
  const match = value.trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)$/i);
  if (!match) return value;
  let hour = Number(match[1]) % 12;
  if (match[3]!.toUpperCase() === "PM") hour += 12;
  return `${String(hour).padStart(2, "0")}:${match[2] || "00"}`;
};
const openingHoursSpecification = hours.flatMap((row) => {
  if (row.time.toLowerCase() === "closed") return [];
  const [opens = "", closes = ""] = row.time.split("–");
  return [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: dayGroups[row.days] || row.days,
    opens: time24(opens),
    closes: time24(closes),
  }];
});

const schema = {
  "@context": "https://schema.org",
  "@type": niche.schemaOrgType,
  name: business.name,
  image: new URL(siteAssets.logoLight!.src, site.url).href,
  telephone: business.phoneTel,
  email: business.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: business.city,
    addressRegion: business.region,
    addressCountry: business.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.latitude,
    longitude: business.longitude,
  },
  url: site.url,
  openingHoursSpecification,
  areaServed: [{ "@type": "City", name: business.city }],
  priceRange: business.priceRange,
};

const { colors } = niche.theme;
const fontSans = niche.theme.fontSans ?? 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
const themeCss = `:root{--theme-surface:${colors.surface};--theme-surface-alt:${colors.surfaceAlt};--theme-accent:${colors.accent};--theme-ink:${colors.ink};--theme-ink-soft:${colors.inkSoft};--theme-font-sans:${fontSans}}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href={favicon256.src} type="image/png" sizes="256x256" />
<link rel="icon" href={favicon32.src} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={appleTouchIcon.src} />
<meta name="theme-color" content={niche.theme.themeColor} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<style is:inline set:html={themeCss}></style>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{
  extraSchemas.map((extra) => (
    <script type="application/ld+json" set:html={JSON.stringify(extra)} />
  ))
}
