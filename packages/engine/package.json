    "@lead-gen/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "5.18.2",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
