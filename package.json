{
  "name": "lead-gen-sites",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Monorepo for many local lead-gen sites: one Astro engine per niche, one Cloudflare Worker per site.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "new-site": "tsx packages/cli/src/bin.ts new-site",
    "check": "tsx packages/cli/src/bin.ts check",
    "build": "tsx packages/cli/src/bin.ts build",
    "deploy": "tsx packages/cli/src/bin.ts deploy",
    "domains": "tsx packages/cli/src/bin.ts domains",
    "secrets": "tsx packages/cli/src/bin.ts secrets",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify-local": "tsx packages/cli/src/bin.ts verify-local",
    "affected": "tsx packages/cli/src/bin.ts affected"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^22.19.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
